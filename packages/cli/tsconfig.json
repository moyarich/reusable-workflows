{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/cli.ts",
    "src/index.ts",
    "src/setup-workspace-tools/setup-workspace-tools.ts",
    "src/release-draft-sync/identity.ts",
    "src/browser-extension-publish/*.ts",
    "scripts/**/*.ts",
    "src/check-dist/**/*.ts",
    "src/resolve-workspaces/**/*.ts",
    "src/verify-workflow-runs/**/*.ts",
    "src/workflow-dispatch/workflow-dispatch.ts",
    "src/validate-release-identity/*.ts"
  ]
}
