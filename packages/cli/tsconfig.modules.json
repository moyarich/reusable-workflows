{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/bin/**",
    "src/**/action-entry.ts",
    "src/browser-extension-publish/entry.ts",
    "dist",
    "node_modules"
  ]
}
