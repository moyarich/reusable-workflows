{
  "name": "@moyarich/reusable-workflows-cli",
  "version": "0.2.2",
  "type": "module",
  "description": "Commander CLI for reusable workflows",
  "bin": {
    "reusable-workflows-cli": "dist/bin/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && tsc -p tsconfig.modules.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:pack": "npm run build && npm pack --dry-run",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:copy-workflows": "vitest run tests/copy-files-to-another-repository/copy-workflow-generation.",
    "build:workflow-runtime": "vite build --config vite.workflow.config.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^14.0.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@moyarich/vite-plugin-package-bin": "git+https://github.com/moyarich/vite-package-bin.git",
    "@types/node": "^24.19.2"
  },
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json",
    "./schemas/copy-files-config.schema.json": "./dist/schemas/copy-config.schema.json",
    "./schemas/*": "./dist/schemas/*",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/reusable-workflows.git",
    "directory": "packages/cli"
  },
  "main": "./index.js",
  "sideEffects": [
    "./dist/bin/**"
  ]
}
