{
  "name": "@moyarich/reusable-workflows-cli",
  "version": "0.2.2",
  "type": "module",
  "description": "Commander CLI for reusable workflows",
  "bin": {
    "reusable-workflows-cli": "dist/bin/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && vite build --config vite.lib.config.ts && node scripts/ensure-bin-executable.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:pack": "npm pack --dry-run",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:copy-workflows": "vitest run tests/copy-workflow-generation.test.ts",
    "sync:workflow-choices": "node dist/bin/cli.mjs sync-workflow-choices"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^14.0.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/lib/index.mjs"
    },
    "./release-identity": {
      "types": "./dist/types/release-draft-sync/identity.d.ts",
      "default": "./dist/lib/release-identity.mjs"
    },
    "./workspace-source": {
      "types": "./dist/types/setup-workspace-tools/setup-workspace-tools.d.ts",
      "default": "./dist/lib/workspace-source.mjs"
    },
    "./browser-manifest": {
      "types": "./dist/types/browser-extension-publish/manifest.d.ts",
      "default": "./dist/lib/browser-manifest.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "unplugin-dts": "^1.1.2"
  }
}
