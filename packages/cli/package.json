{
  "name": "@moyarich/reusable-workflows-cli",
  "version": "0.2.2",
  "type": "module",
  "description": "Commander CLI for reusable workflows",
  "bin": {
    "reusable-workflows": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build --config vite.config.ts && vite build --config vite.lib.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:actions": "vite build --config vite.action.config.ts",
    "check:pack": "npm pack --dry-run"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "default": "./dist/cli.mjs"
    },
    "./release-identity": "./dist/lib/release-identity.mjs",
    "./workspace-source": "./dist/lib/workspace-source.mjs",
    "./browser-manifest": "./dist/lib/browser-manifest.mjs",
    "./package.json": "./package.json"
  }
}
