{
  "name": "reusable-workflows-workspace",
  "private": true,
  "type": "module",
  "version": "0.2.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @moyarich/reusable-workflows-playground",
    "build:playground": "npm run build --workspace @moyarich/reusable-workflows-playground",
    "build:cli": "npm run build:actions",
    "check:cli-dist": "npm run build:actions && git diff --exit-code -- actions/",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run format:check && npm run lint && npm run typecheck",
    "build:package": "npm run build --workspace @moyarich/reusable-workflows-cli",
    "build:actions": "node packages/cli/scripts/build-actions.mjs",
    "build:all": "npm run build:actions && npm run build:package"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/reusable-workflows.git"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "@types/node": "^24.3.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0"
  }
}
