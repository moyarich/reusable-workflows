{
  "name": "reusable-workflows-workspace",
  "private": true,
  "version": "0.2.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @moyarich/reusable-workflows-playground",
    "build:playground": "npm run build --workspace @moyarich/reusable-workflows-playground",
    "build:cli": "vite build",
    "test:cli": "vitest run tests/setup-workspace-tools.test.ts",
    "check:cli-dist": "npm run build:cli && git diff --exit-code -- actions/dist/"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyarich/reusable-workflows.git"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
